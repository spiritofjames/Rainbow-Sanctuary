# Stripe sandbox values for local/Preview use. Never commit real values.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_ALLOWED_GROUP_EVENT_IDS=group-healing-2026-08-22
STRIPE_ALLOWED_OFFER_IDS=group-healing,spiral-i-standard,spiral-ii-standard,spiral-iii-standard,spiral-iv-standard,regeneration-level-i,regeneration-level-ii,earth-healer-level-i,earth-healer-level-ii,crystal-healing,intuitive-perception-training,adult-potential-development,childrens-potential-coach-certification
STRIPE_ALLOWED_CHECKOUT_ORIGINS=http://localhost:3000,https://staging.rainbowsanctuary.life

# Tax remains off until the merchant entity, account country, registrations and
# tax treatment are confirmed. Both gates are required for Production Checkout.
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_TAX_DISPLAY_APPROVED=false

# Production remains blocked unless this is explicitly true and STRIPE_SECRET_KEY is live.
STRIPE_LIVE_CHECKOUT_APPROVED=false

# Stripe-to-CRM delivery is sandbox-only until the separate live-payment gate is approved.
CRM_STRIPE_EVENT_URL=https://psn-relationship-hub.vercel.app/api/intake/stripe
CRM_STRIPE_EVENT_SECRET=replace_with_a_distinct_32_character_minimum_handoff_key

# Public enquiries use a same-origin server bridge. Keep disabled until its staged replay test passes.
CRM_WEBSITE_INTAKE_ENABLED=false
CRM_WEBSITE_INTAKE_URL=https://psn-relationship-hub.vercel.app/api/intake/website
CRM_WEBSITE_INTAKE_SECRET=replace_with_a_distinct_32_character_minimum_intake_key
CRM_ALLOWED_INTAKE_ORIGINS=http://localhost:3000,https://staging.rainbowsanctuary.life

# Resend is outbound-only. Gmail / Google Workspace remains the reply inbox.
# Preview must stay allowlisted. Production requires its own explicit approval.
RESEND_EMAIL_ENABLED=false
RESEND_API_KEY=re_replace_with_domain_restricted_sending_key
RESEND_ALLOWED_RECIPIENTS=workspace-admin@rainbowsanctuary.life
RESEND_PRODUCTION_APPROVED=false
RESEND_WEBHOOK_SECRET=whsec_replace_me

# Local provisioning only. Never add this Full Access key to Vercel.
RESEND_SETUP_API_KEY=re_replace_with_short_lived_full_access_key
