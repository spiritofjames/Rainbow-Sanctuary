# Stripe sandbox values for local/Preview use. Never commit real values.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_ALLOWED_GROUP_EVENT_IDS=group-healing-2026-08-18
# Optional override. The approved Group Healing Stripe Price is configured in
# the offer catalogue so client-selected dates retain metadata in Checkout.
STRIPE_GROUP_HEALING_PRICE_ID=price_1U5T0nHrqlaOfUb7gorSAoaJ
GROUP_HEALING_ZOOM_JOIN_URL=https://your-account.zoom.us/j/00000000000?pwd=replace-with-zoom-passcode
GROUP_HEALING_REMINDERS_ENABLED=false
RAINBOW_OPERATIONS_CALENDAR_SYNC_ENABLED=false
# Ethel-authorized OAuth client: calendar.events scope on both staff calendars.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
RAINBOW_OPERATIONS_CALENDAR_ID=c_8c06ed271e76489612837b0ff0e06b8c48b1c9205e4263903f6319f75db81b10@group.calendar.google.com
PSN_TEAM_CALENDAR_ID=c_9f46da2ecb079c736bd3a573a54f60074cbdefc406e861f333a2bba31133edb3@group.calendar.google.com
GROUP_HEALING_OPERATIONS_EVENT_ID=m6galvun5efuib7knu6g6j6h2k
GROUP_HEALING_PSN_EVENT_ID=rainbowsanctuarygrouph
# Public Checkout opens only for the explicitly named public journeys below.
# Programme payments otherwise use staff-controlled signed payment invitations.
STRIPE_ALLOWED_REGENERATION_EVENT_IDS=regeneration-maintenance-2026-08-17,regeneration-maintenance-2026-08-24,regeneration-maintenance-2026-08-31,regeneration-maintenance-2026-09-07,regeneration-maintenance-2026-09-14,regeneration-maintenance-2026-09-21,regeneration-maintenance-2026-09-28,regeneration-maintenance-2026-10-05,regeneration-maintenance-2026-10-12,regeneration-maintenance-2026-10-19,regeneration-maintenance-2026-10-26,regeneration-maintenance-2026-11-02,regeneration-maintenance-2026-11-09,regeneration-maintenance-2026-11-16
STRIPE_ALLOWED_OFFER_IDS=group-healing,regeneration-maintenance
STRIPE_ALLOWED_CHECKOUT_ORIGINS=http://localhost:3000,https://staging.rainbowsanctuary.life
# Optional stable Stripe Prices for the public Maintenance commitments. When
# configured, Checkout uses these instead of creating anonymous price_data.
STRIPE_REGENERATION_MAINTENANCE_MONTHLY_PRICE_ID=price_replace_with_live_or_test_monthly_price
STRIPE_REGENERATION_MAINTENANCE_THREE_MONTH_PRICE_ID=price_replace_with_live_or_test_twelve_week_price

# Internal staff payment invitations. The signing secret is a minimum 32-character
# random value and must never be exposed to the browser or committed to source.
STRIPE_STAFF_PAYMENT_OFFER_IDS=spiral-i-standard,spiral-i-early-bird,spiral-ii-standard,spiral-ii-early-bird,spiral-iii-standard,spiral-iii-early-bird,spiral-iv-standard,spiral-iv-early-bird,regeneration-level-i,regeneration-level-ii,earth-healer-level-i,earth-healer-level-ii,crystal-healing,intuitive-perception-training,adult-potential-development,childrens-potential-coach-certification
PAYMENT_INVITE_SIGNING_SECRET=replace_with_a_distinct_random_32_character_minimum_key
PAYMENT_INVITE_BASE_URL=https://staging.rainbowsanctuary.life
STRIPE_PAYMENT_LINKS_LIVE_APPROVED=false

# Tax remains off until the merchant entity, account country, registrations and
# tax treatment are confirmed. Both gates are required for Production Checkout.
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_TAX_DISPLAY_APPROVED=false

# Production remains blocked unless this is explicitly true and STRIPE_SECRET_KEY is live.
STRIPE_LIVE_CHECKOUT_APPROVED=false

# Stripe-to-CRM delivery is sandbox-only until the separate live-payment gate is approved.
CRM_STRIPE_EVENT_URL=https://psn-relationship-hub.vercel.app/api/intake/stripe
CRM_STRIPE_EVENT_SECRET=replace_with_a_distinct_32_character_minimum_handoff_key

# Public enquiries use a same-origin server bridge. Keep disabled until its staged replay test passes.
CRM_WEBSITE_INTAKE_ENABLED=false
CRM_WEBSITE_INTAKE_URL=https://psn-relationship-hub.vercel.app/api/intake/website
CRM_WEBSITE_INTAKE_SECRET=replace_with_a_distinct_32_character_minimum_intake_key
CRM_ALLOWED_INTAKE_ORIGINS=http://localhost:3000,https://staging.rainbowsanctuary.life

# HubSpot mirrors enquiry context to Ethel's owned contact. Private Healing remains
# separately fail-closed until the private app token has `files` and contact-write
# access and the complete staging upload/deletion test has passed.
HUBSPOT_INTAKE_ENABLED=false
HUBSPOT_ACCESS_TOKEN=pat-replace_with_private_app_token
HUBSPOT_OWNER_ID=replace_with_ethel_owner_id
HUBSPOT_PORTAL_ID=replace_with_portal_id
HUBSPOT_PRIVATE_INTAKE_ENABLED=false
HUBSPOT_PRIVATE_INTAKE_TTL=P30D

# Resend is outbound-only. Gmail / Google Workspace remains the reply inbox.
# Preview must stay allowlisted. Production requires its own explicit approval.
RESEND_EMAIL_ENABLED=false
RESEND_API_KEY=re_replace_with_domain_restricted_sending_key
RESEND_ALLOWED_RECIPIENTS=workspace-admin@rainbowsanctuary.life,ethel@rainbowsanctuary.life
RESEND_PRODUCTION_APPROVED=false
RESEND_WEBHOOK_SECRET=whsec_replace_me
# The named Operations owner receives idempotent enquiry and payment alerts.
RAINBOW_OPERATIONS_EMAIL=ethel@rainbowsanctuary.life

# Local provisioning only. Never add this Full Access key to Vercel.
RESEND_SETUP_API_KEY=re_replace_with_short_lived_full_access_key
